memories/USER.md.lock

# ── NOTE: hermes-agent/ is NOT excluded here ──
# When building locally (with submodule init), the source files are available.
# When Easypanel clones (without submodule init), the dir is empty and the
# Dockerfile falls back to git clone from GitHub in Stage 1.
# Only exclude the nested .git and heavy subdirs:

# ── hermes-agent: git metadata ──
hermes-agent/.git/
hermes-agent/.gitmodules

# ── hermes-agent: heavy dirs excluded from Docker context ──
hermes-agent/node_modules/
hermes-agent/.venv/
hermes-agent/venv/
hermes-agent/__pycache__/
hermes-agent/.plans/
hermes-agent/.notebooklm-cli-venv/
hermes-agent/.notebooklm-playwright/

# ── hermes-agent: not needed for gateway build ──
hermes-agent/tests/
hermes-agent/tests-js/
hermes-agent/website/
hermes-agent/docs/
hermes-agent/assets/
hermes-agent/infographic/
hermes-agent/nix/
hermes-agent/flake.nix
hermes-agent/flake.lock
hermes-agent/packaging/
hermes-agent/contributors/
hermes-agent/datagen-config-examples/
hermes-agent/.github/

# ── hermes-agent: desktop app (not needed for gateway) ──
hermes-agent/apps/desktop/
hermes-agent/apps/desktop/**

# ── hermes-agent: IDE / CI / misc ──
hermes-agent/.env
hermes-agent/.envrc
hermes-agent/.gitattributes
hermes-agent/.hadolint.yaml
hermes-agent/.mailmap
hermes-agent/.prettierignore
hermes-agent/.prettierrc
hermes-agent/eslint.config.shared.mjs
hermes-agent/.hermes-bootstrap-complete
hermes-agent/.pip-cache/
hermes-agent/.uv-cache/
